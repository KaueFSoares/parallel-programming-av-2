{
  "name": "cnpj-parallel-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Parallel processing pipeline for the Receita Federal CNPJ Estabelecimentos dataset (Lambda + S3 + Step Functions), with a controlled concurrency-scaling experiment.",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prep": "tsx src/prepare.ts",
    "experiment": "tsx src/experiment.ts",
    "report": "tsx src/report.ts",
    "synth": "cdk synth",
    "deploy:local": "bash scripts/deploy-local.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/client-sfn": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "aws-cdk": "^2.160.0",
    "aws-cdk-lib": "^2.160.0",
    "aws-cdk-local": "^3.0.4",
    "constructs": "^10.4.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true
  }
}
